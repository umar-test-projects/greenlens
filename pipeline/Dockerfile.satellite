FROM public.ecr.aws/lambda/python:3.12
RUN dnf install -y expat && dnf clean all
COPY pipeline/requirements-worker.txt ${LAMBDA_TASK_ROOT}/requirements.txt
RUN pip install --no-cache-dir --only-binary=:all: -r ${LAMBDA_TASK_ROOT}/requirements.txt
COPY backend/src/satellite_geometry.py backend/src/satellite_store.py ${LAMBDA_TASK_ROOT}/
COPY pipeline/satellite_rasters.py pipeline/satellite_worker.py ${LAMBDA_TASK_ROOT}/
CMD ["satellite_worker.handler"]
